SELECT * FROM customers;
SELECT orders.order_id, customers.name, orders.order_details FROM orders INNER JOIN customers ON orders.customer_name = customers.name;
SELECT customers.name, orders.order_details FROM customers LEFT JOIN orders ON customers.name = orders.customer_name;
SELECT customers.name, orders.order_details FROM customers RIGHT JOIN orders ON customers.name = orders.customer_name;
SELECT customers.name, COUNT(orders_new.order_id) AS total_orders
FROM customers
LEFT JOIN orders_new ON customers.customer_id = orders_new.customer_id
GROUP BY customers.name;
